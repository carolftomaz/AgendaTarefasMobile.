<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgendaTarefasMobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Minha Agenda</ApplicationTitle>
    <ApplicationId>br.com.agendatarefasmobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
	  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" /> 
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <MauiImage Include="Resources\Images\*.png" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#7853A6" BaseSize="256,256" />
  </ItemGroup>
</Project>
