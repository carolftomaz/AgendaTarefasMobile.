<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaTarefasMobile.Views.HistoryPage"
             Title="Histórico">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Label Text="Histórico de atividades" FontSize="25" FontAttributes="Bold" />
        <Label Grid.Row="1" Text="Últimas alterações registradas no SQLite" FontSize="13" />
        <ListView Grid.Row="2" ItemsSource="{Binding Activities}" BackgroundColor="White" SeparatorVisibility="Default">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Display}" Detail="{Binding Details}" TextColor="#2D2540" DetailColor="#786A90" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>
