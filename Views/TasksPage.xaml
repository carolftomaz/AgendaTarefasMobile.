<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaTarefasMobile.Views.TasksPage"
             Title="Tarefas">
    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="60,*" ColumnSpacing="12">
            <Image Source="agenda.png" WidthRequest="56" HeightRequest="56" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="Minha Agenda" FontSize="26" FontAttributes="Bold" />
                <Label Text="{Binding Summary}" FontSize="13" TextColor="#786A90" />
            </VerticalStackLayout>
        </Grid>
        <Button Grid.Row="1" Text="+ Adicionar tarefa" Clicked="AddClicked" />
        <SearchBar Grid.Row="2" Placeholder="Pesquisar tarefas" Text="{Binding Search}" BackgroundColor="White" />
        <HorizontalStackLayout Grid.Row="3" Spacing="8" VerticalOptions="Center">
            <CheckBox IsChecked="{Binding PendingOnly}" Color="#7853A6" />
            <Label Text="Mostrar somente pendentes" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <ListView Grid.Row="4" ItemsSource="{Binding Tasks}" ItemSelected="TaskSelected" SeparatorVisibility="None" HasUnevenRows="True" BackgroundColor="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Border BackgroundColor="White" Stroke="#EADFF2" StrokeThickness="1" Padding="14" Margin="0,4" StrokeShape="RoundRectangle 14">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="12" TextColor="#7853A6" />
                                <Label Grid.Row="1" Text="{Binding DateText}" FontSize="12" TextColor="#786A90" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding PriorityText}" FontSize="12" />
                            </Grid>
                        </Border>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>
