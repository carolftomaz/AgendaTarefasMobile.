<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgendaTarefasMobile.App">
    <Application.Resources>
        <Color x:Key="Primary">#7853A6</Color>
        <Color x:Key="Background">#F8F5FC</Color>
        <Color x:Key="Ink">#2D2540</Color>
        <Color x:Key="Soft">#EBE1F5</Color>
        <Style TargetType="ContentPage">
            <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
        <Style TargetType="Editor">
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
        </Style>
    </Application.Resources>
</Application>
